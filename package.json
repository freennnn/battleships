{
  "name": "battleships",
  "version": "1.0.0",
  "description": "Battleships game backend",
  "main": "src/index.js",
  "type": "module",
    "scripts": {
        "start": "node src/index.js",
        "dev": "nodemon src/index.js",
        "dev:ts": "tsx watch src/index.ts",
        "build": "tsc",
        "test": "jest",
        "lint": "biome lint src/",
        "lint:fix": "biome lint --write src/",
        "format": "biome format src/",
        "format:fix": "biome format --write src/",
        "check": "biome check src/",
        "check:fix": "biome check --write src/"
    },
  "dependencies": {
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
